<%= render "user_templates/user_navbar", user: @matching_user %>

<article>
  <header>
    <h2><%= @matching_user.username %></h2>
  </header>

  <dl>
    <dt>Private</dt>
    <dd><%= @matching_user.private %></dd>

    <dt>Followers</dt>
    <dd>
      <%= @matching_user.received_follow_requests.where(status: "accepted").count %>

      <% unless current_user == @matching_user %>

        <% if @followed_users_ids.include?(@matching_user.id) %>
          <a href="/delete_follow_request/<%= @matching_user.id %>">Unfollow</a>
        <% else %>

          <form action="/insert_follow_request" method="post">
            <input type="hidden" name="query_recipient_id" value="<%= @matching_user.id %>">

            <button type="submit">
              Follow
            </button>
          </form>

        <% end%>
      <% end%>

    </dd>

    <dt>Following</dt>
    <dd><%= @matching_user.sent_follow_requests.count %></dd>
  </dl>
</article>

<% if current_user == @matching_user %>
  <article>
    <header>
      <h4>Pending follow requests</h4>
    </header>

    <ul>
      <% @pending_requests.each do |request| %>

        <li>
          <%= request.sender.username %>
          <form action="/modify_follow_request/<%= request.id %>" method="post">
            <input name="query_status" value="accepted" type="hidden">

            <button type="submit">
              Accept
            </button>
          </form>

          <form action="/modify_follow_request/<%= request.id %>" method="post">
            <input name="query_status" value="rejected" type="hidden">

            <button type="submit">
              Reject
            </button>
          </form>
        </li>
      <% end %>

    </ul>
  </article>

<% end %>
