<%= render "user_templates/user_navbar", user: @matching_user %>

<article>
  <header>
    <h2><%= @matching_user.username %>'s own photos (<%= @own_photos.count %>)</h2>
  </header>

  <div class="overflow-auto">
    <table>
      <thead>
        <tr>
          <th>
            Image
          </th>

          <th>
            Owner
          </th>

          <th>
            Caption
          </th>

          <th>
            Posted
          </th>

          <th>
            Likes
          </th>

          <th>
            Details
          </th>
        </tr>
      </thead>

      <tbody>
        <% @own_photos.each do |photo| %>
          <tr>
          <td>
            <img src="<%= photo.image %>" class="img-responsive">
          </td>

          <td>
            <%= photo.owner.username %>
          </td>

          <td>
            <%= photo.caption %>

          </td>

          <td>
            <%= time_ago_in_words(photo.created_at) %> ago

          </td>

          <td>
            <%= photo.likes_count %>
          </td>

          <td>
            <a href="/photos/<%= photo.id %>">
              Show details
            </a>
          </td>
        </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</article>
