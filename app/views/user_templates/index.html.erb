<article>
  <header>
    <h2>List of all users</h2>
  </header>

  <div class="overflow-auto">
    <table>
      <thead>
        <tr>
          <th>
            Username
          </th>

          <th>
            Private?
          </th>

          <th>Follow/Unfollow (sign in to view)</th>
          <th>Details page</th>
        </tr>
      </thead>

      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td>
              <%= user.username %>
            </td>

            <td>
              <%= user.private ? "Yes" : "No" %>
            </td>

            <td>

              <% if %>
                              
                <form action="/insert_follow_request" method="post">
                  <input type="hidden" name="query_recipient_id" value="<%= user.id %>">
                  <button type="submit">Follow</button>
                </form>

              <%  else %>
                <form action="/insert_follow_request" method="post">
                  <input type="hidden" name="query_recipient_id" value="<%= user.id %>">
                  <button type="submit">Follow</button>
                </form>
              <% end %>
              
            </td>

            <td>
              <a href="/users/<%= user.username %>">Show details</a>
            </td>
          </tr>

        <% end %>
      </tbody>
    </table>
  </div>
</article>
