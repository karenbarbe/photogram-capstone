<article>
  <header>
    <h2>List of all users</h2>
  </header>

  <div class="overflow-auto">
    <table>
      <thead>
        <tr>
          <th>
            Username
          </th>

          <th>
            Private?
          </th>

          <th>Follow/Unfollow (sign in to view)</th>
          <th>Details page</th>
        </tr>
      </thead>

      <tbody>
        <% @users.each do |user| %>
          <%# Find an existing follow request between current user and this user %>
          <% existing_request = user.received_follow_requests.find_by(sender: current_user) %>

          <tr>
            <td>
              <%= user.username %>
            </td>

            <td>
              <%= user.private ? "Yes" : "No" %>
            </td>

            <td>
              <% if current_user == nil%>
                <%= nil %>
              <% else %>

                <% if user.private %>
                  <%# Private user %>
                  <% if existing_request && existing_request.status == "pending" %>
                    Request sent. <a href="/delete_follow_request/<%= existing_request.id %>">Cancel</a>

                  <% elsif existing_request && existing_request.status == "accepted" %>
                    <a href="/delete_follow_request/<%= existing_request.id %>">Unfollow</a>
                  <% else%>
                    <form action="/insert_follow_request" method="post">
                      <input type="hidden" name="query_recipient_id" value="<%= user.id %>">
                      <button type="submit">Follow</button>
                    </form>
                  <% end %>

                <%  else %>
                  <%# Public user %>
                  <% if existing_request && existing_request.status == "accepted" %>
                    <a href="/delete_follow_request/<%= existing_request.id %>">Unfollow</a>
                  <% else%>
                    <form action="/insert_follow_request" method="post">
                      <input type="hidden" name="query_recipient_id" value="<%= user.id %>">
                      <button type="submit">Follow</button>
                    </form>
                  <% end %>

                <% end %>
              <% end %>

            </td>

            <td>
              <a href="/users/<%= user.username %>">Show details</a>
            </td>
          </tr>

        <% end %>
      </tbody>
    </table>
  </div>
</article>
