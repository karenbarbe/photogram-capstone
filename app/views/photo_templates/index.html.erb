<article>
  <header>
    <h2>Add a new photo</h2>
  </header>
  <% if current_user == nil %>
    <p>To add a photo, you must <a href="/users/sign_in">sign in</a> first.</p>
  <% else %>
    <form action="/insert_photo" method="post" class="form-horizontal" enctype="multipart/form-data">

      <label for="browser_input_image">
        Image
      </label>

      <input type="file" id="browser_input_image" name="query_image" placeholder="Enter URL for the image..." class="form-control" required="">

      <label for="caption_box">
        Caption
      </label>

      <textarea id="caption_box" name="query_caption" rows="2" placeholder="Enter a caption for the photo"></textarea>

      <button type="submit">
        Add photo
      </button>
    </form>
  <% end %>
</article>

<article>
  <header>
    <h2>List of all public photos</h2>
  </header>

  <div class="overflow-auto">
    <table>
      <thead>
        <tr>
          <th>Image</th>
          <th>Caption</th>
          <th>Owner</th>
          <th>Posted</th>
          <th>Likes</th>
          <th>Details page</th>
        </tr>
      </thead>

      <tbody>
        <% @public_photos.each do |photo| %>
          <tr>
            <td>
              <img src="<%= photo.image%>" class="img-responsive">
            </td>

            <td>
              <%= photo.caption %>
            </td>

            <td>
              <%= photo.owner.username %>
            </td>

            <td>
              <%= time_ago_in_words(photo.created_at) %> ago
            </td>

            <td>
              <%= photo.likes_count %>
            </td>

            <td>
              <a href="/photos/<%= photo.id %>">
                Show details
              </a>
            </td>

          </tr>
        <% end %>

      </tbody>
    </table>
  </div>
</article>
